[Unit]
Description=YanXun - kaoyan notice monitor
After=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/yanxun
Environment=YANXUN_HOST=127.0.0.1
Environment=YANXUN_PORT=8000
Environment=YANXUN_DATA=/opt/yanxun/data
ExecStart=/opt/yanxun/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 120 --bind 127.0.0.1:8000 run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
